{
  "name": "ai-explain-papers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Explain: research papers and plain-language articles on large language models, published with GitHub Pages.",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/verify.mjs && astro build && node scripts/verify.mjs --dist",
    "preview": "astro preview",
