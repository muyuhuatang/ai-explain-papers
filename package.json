    "post:new": "node scripts/new-post.mjs",
    "paper:new": "node scripts/new-paper.mjs",
    "paper:version": "node scripts/add-version.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "astro": "^7.4.2",
    "yaml": "^2.9.1"
  }
}
