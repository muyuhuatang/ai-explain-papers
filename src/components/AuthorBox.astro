---
import site from '../../site.config.mjs';
import { ownerLinks } from '../lib/site.mjs';

const { owner } = site;
const position = [owner.title, owner.affiliation].filter(Boolean).join(', ');
---

<aside class="author-box" aria-label="About the author">
  <p class="author-label">Written by</p>
  <p class="author-name">{owner.name}</p>
  {position && <p class="author-affiliation">{position}</p>}
  {
    ownerLinks.length > 0 && (
      <p class="link-row">
        {ownerLinks.map((link) => (
          <a href={link.href} rel="me">
            {link.label}
          </a>
        ))}
      </p>
    )
  }
</aside>
